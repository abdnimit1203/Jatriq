rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Packages: Public can view, only admin can update
    match /packages/{packageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email_verified == true; // Simplified for now
    }

    // Site configuration
    match /site_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email_verified == true;
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Inquiries
    match /inquiries/{inquiryId} {
      allow read: if request.auth != null;
      allow write: if true;
    }
  }
}
