# ==============================================================================
# JATRIQ ENVIRONMENT CONFIGURATION TEMPLATE
# For a fresh Vercel deployment, configure these in:
# Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE ONLY SECRETS (Never prefixed with VITE_, Never exposed to browser)
# Used by Vercel Serverless Function & local Express server for AI features
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional Alternative AI Providers (fallback if configured)
# GROQ_API_KEY="your_groq_api_key_here"
# OPENAI_API_KEY="your_openai_api_key_here"

# Host URL and Port (Local dev default: 3000)
# PORT=3000
# APP_URL="https://your-jatriq-app.vercel.app"

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE ENVIRONMENT VARIABLES (Prefixed with VITE_, Safe for browser bundle)
# Required for Firebase Authentication and Firestore real-time synchronization
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# ------------------------------------------------------------------------------
# 3. ADMIN AUTHORIZATION WHITELIST
# Comma-separated list of Google / Email accounts granted Admin Dashboard access
# ------------------------------------------------------------------------------
VITE_ADMIN_EMAILS="admin@jatriq.com,owner@jatriq.com"
